{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truzhen.local/contracts/approved-pack-artifact-handoff-attestation.schema.json",
  "title": "ApprovedPackArtifactHandoffAttestation",
  "description": "由与云账号绑定的 paired host 使用 Ed25519 对固定 Pack 制品的 Owner-approved handoff 签名。opaque Receipt ref 单独不构成批准证明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["handoff_id", "issuer_host_ref", "audience", "candidate_ref", "approval_receipt_ref", "artifact_ref", "pack_ref", "pack_version_ref", "artifact_sha256", "evidence_refs", "issued_at", "expires_at", "nonce", "signature"],
  "properties": {
    "handoff_id": { "type": "string", "minLength": 1 }, "issuer_host_ref": { "type": "string", "minLength": 1 }, "audience": { "type": "string", "minLength": 1 },
    "candidate_ref": { "type": "string", "minLength": 1 }, "approval_receipt_ref": { "type": "string", "minLength": 1 }, "artifact_ref": { "type": "string", "minLength": 1 },
    "pack_ref": { "type": "string", "minLength": 1 }, "pack_version_ref": { "type": "string", "minLength": 1 }, "artifact_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }, "nonce": { "type": "string", "minLength": 1 }, "signature": { "type": "string", "minLength": 1, "description": "base64 raw Ed25519 signature over canonical JSON excluding this field" }
  }
}
