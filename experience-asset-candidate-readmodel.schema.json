{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truzhen.local/contracts/experience-asset-candidate-readmodel.schema.json",
  "title": "ExperienceAssetCandidateReadModel",
  "description": "仅包含脱敏经验候选与可回放引用的 client-safe 投影；不是 Owner 裁定、正式回执或市场上传证明。",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "candidate_only", "non_formal", "status", "version", "source_receipt_ref", "transaction_ref", "pack_ref", "source_pack_version_ref", "source_module", "provenance", "inherited_permissions", "desensitization_report", "created_at"],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 }, "candidate_only": { "type": "boolean", "const": true }, "non_formal": { "type": "boolean", "const": true },
    "status": { "type": "string", "enum": ["EXTRACTED", "DESENSITIZED", "PENDING_REVIEW", "OWNER_APPROVED", "REJECTED_SENSITIVE"] }, "version": { "type": "integer", "minimum": 1 },
    "source_receipt_ref": { "type": "string", "minLength": 1 }, "transaction_ref": { "type": "string", "minLength": 1 }, "pack_ref": { "type": "string", "minLength": 1 }, "source_pack_version_ref": { "type": "string", "minLength": 1 }, "source_module": { "type": "string", "minLength": 1 },
    "provenance": { "$ref": "#/$defs/provenance" }, "inherited_permissions": { "type": "string", "minLength": 1 }, "desensitized_experience": { "type": "string" }, "desensitization_report": { "$ref": "#/$defs/desensitization_report" },
    "contribution_candidate": { "$ref": "#/$defs/contribution_candidate" }, "pack_version_migration_candidate": { "$ref": "#/$defs/pack_version_migration_candidate" }, "contribution_receipt": { "$ref": "#/$defs/contribution_receipt" }, "pack_version_migration_receipt_ref": { "type": "string", "minLength": 1 }, "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "provenance": { "type": "object", "additionalProperties": false, "required": ["receipt_ref", "transaction_ref", "source_module", "source_hash"], "properties": { "receipt_ref": { "type": "string", "minLength": 1 }, "transaction_ref": { "type": "string", "minLength": 1 }, "task_ref": { "type": "string" }, "source_module": { "type": "string", "minLength": 1 }, "source_hash": { "type": "string", "minLength": 1 } } },
    "desensitization_report": { "type": "object", "additionalProperties": false, "required": ["original_length", "redacted_count", "fields_masked", "rejected"], "properties": { "original_length": { "type": "integer", "minimum": 0 }, "redacted_count": { "type": "integer", "minimum": 0 }, "fields_masked": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }, "rejected": { "type": "boolean" }, "reason": { "type": "string" } } },
    "contribution_candidate": { "type": "object", "additionalProperties": false, "required": ["candidate_id", "source_transaction_ref", "source_pack_ref", "source_pack_version_ref", "sanitization_receipt_ref", "owner_decision_ref", "summary_redacted", "status", "candidate_only", "non_formal", "created_at"], "properties": { "candidate_id": { "type": "string", "minLength": 1 }, "source_transaction_ref": { "type": "string", "minLength": 1 }, "source_pack_ref": { "type": "string", "minLength": 1 }, "source_pack_version_ref": { "type": "string", "minLength": 1 }, "sanitization_receipt_ref": { "type": "string", "minLength": 1 }, "owner_decision_ref": { "type": "string", "minLength": 1 }, "summary_redacted": { "type": "string" }, "status": { "type": "string", "enum": ["proposed", "owner_approved", "submitted", "author_adopted", "rejected"] }, "candidate_only": { "type": "boolean", "const": true }, "non_formal": { "type": "boolean", "const": true }, "created_at": { "type": "string", "format": "date-time" } } },
    "pack_version_migration_candidate": { "type": "object", "additionalProperties": false, "required": ["candidate_id", "transaction_ref", "pack_ref", "from_pack_version_ref", "to_pack_version_ref", "risk_color", "required_owner_action", "status", "candidate_only", "non_formal", "created_at"], "properties": { "candidate_id": { "type": "string", "minLength": 1 }, "transaction_ref": { "type": "string", "minLength": 1 }, "pack_ref": { "type": "string", "minLength": 1 }, "from_pack_version_ref": { "type": "string", "minLength": 1 }, "to_pack_version_ref": { "type": "string", "minLength": 1 }, "diff_summary": { "type": "string" }, "risk_color": { "type": "string", "enum": ["green", "yellow", "orange", "red"] }, "required_owner_action": { "type": "string", "enum": ["owner_confirm", "blocked"] }, "status": { "type": "string", "enum": ["proposed", "owner_rejected", "owner_approved_pending_migration"] }, "candidate_only": { "type": "boolean", "const": true }, "non_formal": { "type": "boolean", "const": true }, "created_at": { "type": "string", "format": "date-time" } } },
    "contribution_receipt": { "type": "object", "additionalProperties": false, "required": ["receipt_ref", "kind", "contribution_candidate_ref", "source_pack_version_ref", "created_at"], "properties": { "receipt_ref": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["owner_authorization", "market_submission", "author_adoption", "market_rejection"] }, "contribution_candidate_ref": { "type": "string", "minLength": 1 }, "source_pack_version_ref": { "type": "string", "minLength": 1 }, "created_at": { "type": "string", "format": "date-time" } } }
  }
}
