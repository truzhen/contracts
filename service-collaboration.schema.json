{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truzhen.local/contracts/service-collaboration.schema.json",
  "title": "ServiceCollaborationContracts",
  "description": "加法的客户限事务服务协作形状；不携带凭据、不产生 OwnerDecision、不是真相源。",
  "oneOf": [
    { "$ref": "#/$defs/service_collaboration_invite" },
    { "$ref": "#/$defs/service_agreement_disclosure" },
    { "$ref": "#/$defs/counterparty_decision_envelope" },
    { "$ref": "#/$defs/daily_delivery_disclosure" },
    { "$ref": "#/$defs/participant_scope_readmodel" }
  ],
  "$defs": {
    "service_collaboration_invite": {"type":"object","additionalProperties":false,"required":["invite_ref","transaction_ref","expected_participant_ref","nonce","expires_at","candidate_only","produces_owner_decision"],"properties":{"invite_ref":{"type":"string","minLength":1},"transaction_ref":{"type":"string","minLength":1},"expected_participant_ref":{"type":"string","minLength":1},"nonce":{"type":"string","minLength":1},"expires_at":{"type":"string","format":"date-time"},"candidate_only":{"const":true},"produces_owner_decision":{"const":false}}},
    "service_agreement_disclosure": {"type":"object","additionalProperties":false,"required":["disclosure_ref","transaction_ref","proposal_version","proposal_hash","expires_at","read_model_only","formal_agreement"],"properties":{"disclosure_ref":{"type":"string","minLength":1},"transaction_ref":{"type":"string","minLength":1},"proposal_version":{"type":"string","minLength":1},"proposal_hash":{"type":"string","minLength":1},"expires_at":{"type":"string","format":"date-time"},"read_model_only":{"const":true},"formal_agreement":{"const":false}}},
    "counterparty_decision_envelope": {"type":"object","additionalProperties":false,"required":["decision_ref","transaction_ref","participant_ref","proposal_version","proposal_hash","nonce","decision","candidate_only","produces_owner_decision"],"properties":{"decision_ref":{"type":"string","minLength":1},"transaction_ref":{"type":"string","minLength":1},"participant_ref":{"type":"string","minLength":1},"proposal_version":{"type":"string","minLength":1},"proposal_hash":{"type":"string","minLength":1},"nonce":{"type":"string","minLength":1},"decision":{"enum":["accepted","revision_requested","rejected"]},"candidate_only":{"const":true},"produces_owner_decision":{"const":false}}},
    "daily_delivery_disclosure": {"type":"object","additionalProperties":false,"required":["disclosure_ref","transaction_ref","agreement_version","item_refs","artifact_refs","read_model_only"],"properties":{"disclosure_ref":{"type":"string","minLength":1},"transaction_ref":{"type":"string","minLength":1},"agreement_version":{"type":"string","minLength":1},"item_refs":{"type":"array","minItems":5,"maxItems":5,"uniqueItems":true,"items":{"type":"string","minLength":1}},"artifact_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"read_model_only":{"const":true}}},
    "participant_scope_readmodel": {"type":"object","additionalProperties":false,"required":["scope_ref","participant_ref","allowed_transaction_refs","allowed_candidate_types","expires_at","read_model_only","can_produce_owner_decision"],"properties":{"scope_ref":{"type":"string","minLength":1},"participant_ref":{"type":"string","minLength":1},"allowed_transaction_refs":{"type":"array","minItems":1,"maxItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"allowed_candidate_types":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},"expires_at":{"type":"string","format":"date-time"},"read_model_only":{"const":true},"can_produce_owner_decision":{"const":false}}}
  }
}
